<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed for LAN servers; the server editor warns about it.
     User-installed CAs are trusted so a private CA installed in Android settings works too. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
